# /outputs/ is heavy generated content (images, intermediate latents).
# Convention: each run lives at outputs/<run-family>/<run-name>/ (exactly 3
# levels). Evidence files at that depth (manifest.jsonl, scores.jsonl,
# geneval_scores.jsonl, summary.md) are re-included below; everything else
# (PNGs, .pt latents, ad-hoc subdirs) stays ignored.
# Figures meant for the report belong under report/figures/, NOT outputs/.
/outputs/*
!/outputs/*/
/outputs/*/*
!/outputs/*/*/
/outputs/*/*/*
!/outputs/*/*/manifest.jsonl
!/outputs/*/*/scores.jsonl
!/outputs/*/*/geneval_scores.jsonl
!/outputs/*/*/summary.md
# Throwaway local-only run dirs (smoke probes, dry-runs, A/B verifications)
/outputs/smoke/
/outputs/dryrun/
/outputs/ab_postfix/
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle

# OMX/OMC/Codex local runtime state (keep plans, ignore session/state files)
.omx/
.omc/state/
.omc/project-memory.json

# Local upstream clones
/external/*
!/external/.gitignore
!/external/README.md
!/external/zigzag-diffusion-sampling/

